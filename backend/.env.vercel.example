# Vercel Environment Variables Template
# Copy these to your Vercel Project Settings → Environment Variables

# ===== REQUIRED =====

# Django Settings Module
DJANGO_SETTINGS_MODULE=config.settings.vercel

# Django Secret Key (Generate a strong key: https://djecrety.ir/)
SECRET_KEY=django-insecure-change-this-to-a-real-secret-key-min-50-characters

# Database URL (Vercel Postgres, Supabase, Neon, etc.)
DATABASE_URL=postgresql://user:password@host.com:5432/database?sslmode=require

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=.vercel.app,.now.sh

# Frontend URL (for CORS)
FRONTEND_URL=https://your-frontend.vercel.app

# CSRF Trusted Origins (comma-separated)
CSRF_TRUSTED_ORIGINS=https://*.vercel.app,https://your-domain.com


# ===== OPTIONAL BUT RECOMMENDED =====

# Email Configuration (for password reset, verification)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password
DEFAULT_FROM_EMAIL=noreply@yourapp.com

# AWS S3 (for media file storage)
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_S3_REGION_NAME=us-east-1

# Sentry (for error tracking)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id


# ===== DEVELOPMENT/TESTING ONLY =====

# Enable debug mode (NEVER set to True in production!)
# DEBUG=False


# ===== QUICK SETUP GUIDE =====

# 1. Database Setup (Choose one):
#
#    Option A: Vercel Postgres
#    - Go to your Vercel project dashboard
#    - Click "Storage" → "Create Database" → "Postgres"
#    - Copy the DATABASE_URL connection string
#
#    Option B: Supabase (Free tier)
#    - Sign up at https://supabase.com
#    - Create a new project
#    - Go to Settings → Database → Copy connection string (URI)
#    - Format: postgresql://postgres:[YOUR-PASSWORD]@[HOST]:5432/postgres?sslmode=require
#
#    Option C: Neon (Free tier)
#    - Sign up at https://neon.tech
#    - Create a project → Copy connection string

# 2. Generate Secret Key:
#    - Go to https://djecrety.ir/
#    - Generate a new secret key
#    - Copy and use as SECRET_KEY

# 3. Email Setup (Gmail):
#    - Enable 2-factor authentication on your Gmail account
#    - Generate an app-specific password:
#      https://myaccount.google.com/apppasswords
#    - Use that password as EMAIL_HOST_PASSWORD

# 4. After setting environment variables:
#    - Redeploy your Vercel project
#    - Run migrations (see VERCEL_DEPLOYMENT.md)
#    - Create superuser
#    - Test the deployment


# ===== TROUBLESHOOTING =====

# If you see "DisallowedHost" error:
# - Make sure ALLOWED_HOSTS includes your Vercel domain
# - Add: .vercel.app,.now.sh,your-project.vercel.app

# If you see CORS errors:
# - Make sure FRONTEND_URL is set correctly
# - Add your frontend domain to CSRF_TRUSTED_ORIGINS

# If database connection fails:
# - Verify DATABASE_URL format
# - Ensure ?sslmode=require is at the end for SSL connections
# - Test connection string locally first

# If static files don't load:
# - Vercel handles static files automatically
# - Make sure STATIC_URL is set to '/static/'
# - Run: vercel env pull to test locally
