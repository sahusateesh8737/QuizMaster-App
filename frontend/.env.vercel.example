# Frontend Environment Variables Template for Vercel

# ===== REQUIRED =====

# Backend API URL - Your deployed Django backend
VITE_API_URL=https://quiz-master-app-swart.vercel.app/api


# ===== OPTIONAL =====

# Enable debug mode (development only)
# VITE_DEBUG=false

# Google Analytics ID (if you add analytics)
# VITE_GA_ID=G-XXXXXXXXXX

# Sentry DSN for error tracking (frontend)
# VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id


# ===== SETUP INSTRUCTIONS =====

# 1. Go to your Vercel project dashboard
# 2. Click on "Settings" → "Environment Variables"
# 3. Add this variable:
#    Name: VITE_API_URL
#    Value: https://quiz-master-app-swart.vercel.app/api
#    Environment: Production, Preview, Development

# 4. Redeploy your frontend project

# Note: All environment variables for Vite must start with VITE_
